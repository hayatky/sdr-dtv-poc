# Set absolute local paths; never commit the completed file.
SDR_UID=1000
SDR_GID=1000
SDR_LIVE_DATA=/path/to/private/app-data
SDR_RESEARCH_SOURCE=/path/to/private/pinned-live-source
SDR_RESEARCH_DEVICE_DIR=/path/to/shared/research-device-directory
SDR_LIVE_CONFIG_DIR=/path/to/private/config
SDR_CAS_DIR=/path/to/unchanged/libaribb25-prefix
SDR_PCSC_DIR=/path/to/private/pcsc
