# SPDX-License-Identifier: GPL-3.0-or-later
# Local build only. Research source and CAS are separately obtained bind mounts.
FROM ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc AS uv
FROM sdr-dtv-native-wideband:issue3
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3.12-venv ffmpeg=7:6.1.1-3ubuntu5 iproute2 libpcsclite1 ca-certificates curl && rm -rf /var/lib/apt/lists/*
# Same unmodified ARIB decoder as the research SI tool; local image only.
RUN curl -fL --retry 2 https://github.com/tsduck/tsduck/releases/download/v3.45-4798/tsduck_3.45-4798.ubuntu24_amd64.deb -o /tmp/tsduck.deb && \
    echo '0023689f76e75b64e45253771208bcf8ca95b91fbfd0900da097c729f3c39fde  /tmp/tsduck.deb' | sha256sum -c - && \
    apt-get update && apt-get install -y --no-install-recommends /tmp/tsduck.deb && \
    rm /tmp/tsduck.deb && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /usr/share/doc/tsduck && \
    curl -fL --retry 2 https://raw.githubusercontent.com/tsduck/tsduck/v3.45-4798/LICENSE.txt -o /usr/share/doc/tsduck/LICENSE.txt && \
    echo '58be33f8bd6df6371a95d310ea0ea405d9d46c5186bd8fb438020ea09d685353  /usr/share/doc/tsduck/LICENSE.txt' | sha256sum -c -
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable --python /usr/bin/python3.12
ENV PATH=/app/.venv/bin:$PATH PYTHONPATH=/app/src:/opt/wideband-build SDR_NATIVE_PYTHONPATH=/opt/wideband-build SDR_DATA_DIR=/data PYTHONUNBUFFERED=1
USER 10001:10001
STOPSIGNAL SIGTERM
CMD ["uvicorn", "sdr_dtv_poc.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "18335", "--workers", "1", "--no-proxy-headers", "--no-access-log", "--timeout-graceful-shutdown", "35"]
