# SPDX-License-Identifier: GPL-3.0-or-later
# Local build only. Research source and CAS are separately obtained bind mounts.
FROM ghcr.io/astral-sh/uv:0.12.18@sha256:3adc3706091ce7c2fe595e669628caedd6d951551b92b258b7e7dbe06d9440bc AS uv
FROM sdr-dtv-native-wideband:issue3
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3.12-venv ffmpeg=7:6.1.1-3ubuntu5 iproute2 libpcsclite1 && rm -rf /var/lib/apt/lists/*
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
RUN uv sync --locked --no-dev --no-editable --python /usr/bin/python3.12
ENV PATH=/app/.venv/bin:$PATH PYTHONPATH=/app/src:/opt/wideband-build SDR_NATIVE_PYTHONPATH=/opt/wideband-build SDR_DATA_DIR=/data PYTHONUNBUFFERED=1
USER 10001:10001
STOPSIGNAL SIGTERM
CMD ["uvicorn", "sdr_dtv_poc.app:create_app", "--factory", "--host", "127.0.0.1", "--port", "18335", "--workers", "1", "--no-proxy-headers", "--no-access-log", "--timeout-graceful-shutdown", "35"]
